<div class="kj-contact-section-wrap color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="kj-contact-grid">
      <div class="kj-contact-info-card">
        <span class="kj-badge">Get in Touch</span>
        <h3>We're here to help</h3>
        <div class="kj-contact-details">
          <div class="kj-contact-detail-row">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>KJ Enterprises<br>Mumbai, Maharashtra, India</span>
          </div>
          <div class="kj-contact-detail-row">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <span>support@kjenterprises.com</span>
          </div>
          <div class="kj-contact-detail-row">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>Mon - Sat: 10:00 AM - 6:00 PM</span>
          </div>
        </div>
        <a href="https://wa.me/919876543210" class="kj-whatsapp-btn">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"/><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"/></svg>
          Chat on WhatsApp
        </a>
      </div>
      <div class="kj-faq-col">
        <span class="kj-badge">FAQ</span>
        <h3>Frequently Asked Questions</h3>
        <div class="kj-faq-list">
          <details class="kj-faq-item">
            <summary class="kj-faq-summary">
              What are your shipping times?
              <svg class="kj-faq-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
            </summary>
            <div class="kj-faq-body">We dispatch all orders within 24 hours. Delivery takes 2-4 business days across major cities in India, and 4-6 days for remote pin codes.</div>
          </details>
          <details class="kj-faq-item">
            <summary class="kj-faq-summary">
              How do I care for 400TC sheets?
              <svg class="kj-faq-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
            </summary>
            <div class="kj-faq-body">Machine wash cold on a gentle cycle with mild detergent. Tumble dry low. Do not bleach. Our sheets soften naturally with every wash.</div>
          </details>
          <details class="kj-faq-item">
            <summary class="kj-faq-summary">
              Do you accept returns?
              <svg class="kj-faq-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
            </summary>
            <div class="kj-faq-body">Yes, we offer a 7-day hassle-free return and exchange policy for unused items in their original packaging.</div>
          </details>
          <details class="kj-faq-item">
            <summary class="kj-faq-summary">
              Are your dyes skin-safe?
              <svg class="kj-faq-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
            </summary>
            <div class="kj-faq-body">Absolutely. We use 100% AZO-free, OEKO-TEX certified dyes that are hypoallergenic and safe for sensitive skin.</div>
          </details>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "KJ Contact Info",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "KJ Contact Info"
    }
  ]
}
{% endschema %}
