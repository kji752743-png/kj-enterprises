{% liquid
  assign reverse = section.settings.reverse_layout
%}
<div class="kj-editorial-section color-{{ section.settings.color_scheme }} gradient">
  <div class="kj-editorial-container{% if reverse %} reversed{% endif %} page-width">
    <div class="kj-editorial-image">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.heading }}
      {%- else -%}
        <img src="{{ 'hero_bed_sheets.jpg' | asset_url }}" alt="Editorial Image" loading="lazy" style="width:100%; height:100%; object-fit:cover; min-height:480px;">
      {%- endif -%}
    </div>
    <div class="kj-editorial-content">
      {%- if section.settings.badge != blank -%}
        <span class="kj-badge">{{ section.settings.badge | escape }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="kj-btn kj-btn-primary">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "KJ Editorial Feature",
  "tag": "section",
  "class": "section",
  "settings": [
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"text","id":"badge","label":"Badge","default":"The KJ Difference"},
    {"type":"text","id":"heading","label":"Heading","default":"Woven for Life's Finest Moments"},
    {"type":"textarea","id":"text","label":"Body Text","default":"Every KJ textile begins its journey at the loom of a master weaver, crafted from hand-selected long-staple cotton chosen for softness, durability, and breathability."},
    {"type":"text","id":"button_label","label":"Button Label","default":"Discover Our Story"},
    {"type":"url","id":"button_link","label":"Button Link"},
    {"type":"checkbox","id":"reverse_layout","label":"Reverse Layout (image right)","default":false},
    {"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"}
  ],
  "presets":[{"name":"KJ Editorial Feature"}]
}
{% endschema %}
